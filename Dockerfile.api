# Dockerfile for ForecastIt API
FROM python:3.11-slim

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    FORECASTIT_ENABLE_PROPHET=true

# Set work directory
WORKDIR /app

# Install system dependencies (including cmdstan build deps)
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN pip install poetry

# Copy Poetry files
COPY pyproject.toml poetry.lock ./

# Configure Poetry
RUN poetry config virtualenvs.create false

# Install dependencies
RUN poetry install --no-dev

# Pre-compile Prophet models to cache cmdstan (optional, graceful if fails)
RUN python -c "import prophet; print('Prophet and cmdstan ready')" || echo "Prophet/cmdstan not available - will gracefully degrade"

# Copy application code
COPY forecastit/ ./forecastit/

# Create non-root user
RUN useradd --create-home --shell /bin/bash forecastit
USER forecastit

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run the application
CMD ["uvicorn", "forecastit.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
